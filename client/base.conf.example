[server]
# WireGuard server public key — this IS the trust anchor for the Noise-IK
# tunnel (JUSTIFICATIONS.md §5). No TLS certificate is involved.
public_key  = REPLACE_WITH_SERVER_PUBKEY
# Server IP or hostname
address     = YOUR_SERVER_IP
# WireGuard UDP port
port        = 51820
# SrvAuthn Noise-IK TCP port
auth_port   = 9999
# For a Docker client, keep this to the VPN subnet. Use 0.0.0.0/0 only
# for a full default-route tunnel.
allowed_ips = 10.10.10.0/24
