[server]
wg_interface        = wg0
wg_listen_port      = 51820
# Paste the value from scripts/init-wg.sh (cat wireguard/publickey-server).
wg_public_key       = REPLACE_WITH_SERVER_PUBKEY
# Path to the server's WireGuard *private* key (spec §2, parameter 1).
# SrvAuthn reads this at startup and logs its fingerprint.
wg_private_key_file = /etc/wireguard/privatekey-server
internal_subnet     = 10.10.10.0/24
# SrvAuthn runs with network_mode=host, so the IdP is reachable on the host loopback.
idp_url             = http://localhost:8080
oauth_client_id     = srvauthn
oauth_client_secret = REPLACE_OR_THE_APP_WILL_REFUSE_TO_START

# The Phase 3 Noise-IK tunnel uses the server's WG private key directly;
# no TLS certificate is needed any more (§3.9).

# Optional override for the proxy egress target (default localhost:8080).
# proxy_target      = localhost:8080

# Lease lifetime for issued WireGuard peers (§4.1). Default 24 h.
lease_ttl_seconds   = 86400
# How often the background sweeper checks for expired leases (§4.2).
lease_sweeper_poll  = 60
