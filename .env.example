# WireGuard server public key.
# Populated by running: bash scripts/init-wg.sh
# (The script will print the value; paste it below.)
# Also doubles as the responder's Noise-IK static key (JUSTIFICATIONS.md §5).
SERVER_PUBKEY=

# Flask session secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The apps refuse to start if this is left as the placeholder (§1.12).
SECRET_KEY=REPLACE_OR_THE_APP_WILL_REFUSE_TO_START

# OAuth client secret. Shared between IdP and SrvAuthn.
OAUTH_CLIENT_SECRET=REPLACE_OR_THE_APP_WILL_REFUSE_TO_START

# IAA master key for at-rest encryption of TOTP secrets (§4.6).
# Generate with:
#   python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Must base64-decode to exactly 32 bytes. The IdP + helpdesk refuse to start
# if this is missing, a placeholder, or the wrong length.
IAA_MASTER_KEY=REPLACE_OR_THE_APP_WILL_REFUSE_TO_START

# WebAuthn / OAuth origin.
#
# After Phase 3, the browser reaches the IdP through the client-side proxy
# at 127.0.0.1:18080 (see client/proxy.py), so:
#
#   - RP_ID must be a registrable suffix of the page origin — we use the
#     literal hostname "127.0.0.1".
#   - ORIGIN is the full origin the browser actually sees during the
#     OAuth/FIDO2 flow, including port.
#   - HELPDESK_ORIGIN is the origin from which FIDO2 credentials are
#     registered. Same RP_ID, different port — both validate cleanly.
RP_ID=localhost
ORIGIN=http://localhost:18080
HELPDESK_ORIGIN=http://localhost:8081
