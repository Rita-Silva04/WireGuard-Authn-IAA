# Server public IP or hostname
SERVER_URL=YOUR_PUBLIC_IP

# WireGuard server public key (cat wireguard/server/publickey-server)
SERVER_PUBKEY=

# Flask session secret — generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# OAuth client secret (shared between IdP and SrvAuthn)
OAUTH_CLIENT_SECRET=change-me-too

# WebAuthn RP settings
# RP_ID  = hostname only (no scheme, no port)
# ORIGIN = full origin the browser sees
RP_ID=localhost
ORIGIN=http://localhost
HELPDESK_ORIGIN=http://localhost:8081
