# WireGuard server public key.
# Populated by running: bash scripts/init-wg.sh
# (The script will print the value; paste it below.)
SERVER_PUBKEY=

# Flask session secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# OAuth client secret. Shared between IdP and SrvAuthn.
OAUTH_CLIENT_SECRET=change-me-too

# WebAuthn settings.
#   RP_ID  - hostname only, no scheme or port. Must match across IdP + helpdesk
#            so a credential registered on the helpdesk can authenticate at the IdP.
#   ORIGIN - the full origin the browser actually sees (including port).
RP_ID=localhost
ORIGIN=http://localhost:8080
HELPDESK_ORIGIN=http://localhost:8081
